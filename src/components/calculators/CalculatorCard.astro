---
interface Props {
  serial: string;
  category: string;
  title: string;
  question?: string;
  description: string;
  href: string;
  actionLabel?: string;
}

const {
  serial,
  category,
  title,
  question,
  description,
  href,
  actionLabel = 'Open',
} = Astro.props;
---

<article class="tool-card work-order-card">
  <p class="calculator-category">{category}</p>
  <h3>{title}</h3>
  {question && <p class="card-question">{question}</p>}
  <p>{description}</p>
  <div class="work-order-footer" aria-label={`${serial}, ${category}`}>
    <a class="card-link" href={href}>{actionLabel} <span aria-hidden="true">→</span></a>
    <span class="calculator-serial">{serial}</span>
  </div>
</article>
