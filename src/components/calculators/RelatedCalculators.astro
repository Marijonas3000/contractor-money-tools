---
export interface RelatedCalculator {
  title: string;
  description: string;
  href: string;
}

interface Props {
  calculators: RelatedCalculator[];
}

const calculators = Astro.props.calculators.filter(({ href }) => href.startsWith('/'));
---

{calculators.length > 0 && (
  <nav class="content-section related-calculators" aria-labelledby="related-calculators-title">
    <p class="step">Related calculators</p>
    <h2 id="related-calculators-title">Explore more business calculators</h2>
    <ul>
      {calculators.map((calculator) => (
        <li>
          <a href={calculator.href}>{calculator.title}</a>
          <p>{calculator.description}</p>
        </li>
      ))}
    </ul>
  </nav>
)}
