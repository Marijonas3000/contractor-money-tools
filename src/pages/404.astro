---
import SiteLayout from '../layouts/SiteLayout.astro';

const pageTitle = 'Page Not Found | Contractor Money Tools';
const pageDescription = 'The requested Contractor Money Tools page could not be found.';
---

<SiteLayout title={pageTitle} description={pageDescription} noindex>
  <section class="content-hero not-found-panel blueprint-grid" aria-labelledby="not-found-title">
    <p class="eyebrow">Error 404</p>
    <h1 id="not-found-title">Page not found</h1>
    <p>The page may have moved or the address may be incorrect.</p>
    <div class="button-row">
      <a class="button button-primary" href="/">Go to homepage</a>
      <a class="button button-secondary" href="/calculators/">Explore calculators</a>
    </div>
  </section>
</SiteLayout>
