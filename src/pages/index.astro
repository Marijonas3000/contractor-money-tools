---
import SiteLayout from '../layouts/SiteLayout.astro';
import CalculatorCard from '../components/calculators/CalculatorCard.astro';

const pageTitle = 'Free Money Tools for Contractors | Contractor Money Tools';
const pageDescription = 'Free calculators that help U.S. contractors understand labor costs, employee costs, overhead, hourly pricing, and job markup.';
const calculators = [
  {
    serial: 'CMT-01',
    category: 'Labor',
    title: 'Labor Burden Calculator',
    question: 'What does an employee really cost per productive hour?',
    description: 'Add wage-based costs, benefits, and paid nonproductive time to estimate true productive-hour cost.',
    href: '/calculators/labor-burden',
  },
  {
    serial: 'CMT-02',
    category: 'Labor',
    title: 'True Employee Cost Calculator',
    question: 'What does an employee really cost my business per year?',
    description: 'Estimate the full annual employer cost of an hourly or salaried employee beyond base pay.',
    href: '/calculators/true-employee-cost',
  },
  {
    serial: 'CMT-03',
    category: 'Pricing',
    title: 'Contractor Hourly Rate Calculator',
    question: 'How much should I charge per billable hour?',
    description: 'Turn owner compensation, overhead, billable hours, and a target margin into a practical billing rate.',
    href: '/calculators/contractor-hourly-rate',
  },
  {
    serial: 'CMT-04',
    category: 'Pricing',
    title: 'Contractor Markup Calculator',
    question: 'I know what the job costs. What selling price do I get after markup?',
    description: 'Turn an itemized or total job cost into a selling price, or work backward from target margin or a proposed price.',
    href: '/calculators/contractor-markup',
  },
  {
    serial: 'CMT-05',
    category: 'Overhead',
    title: 'Contractor Overhead Calculator',
    question: 'What does it cost to keep my business running, and how can that overhead be recovered?',
    description: 'Total annual company overhead and view it by revenue, direct labor, direct job cost, or productive field hours.',
    href: '/calculators/contractor-overhead',
  },
  {
    serial: 'CMT-06',
    category: 'Job costing',
    title: 'Contractor Job Profit & Costing Calculator',
    question: 'Did this job perform as expected, and where did the difference come from?',
    description: 'Compare estimated and actual revenue, direct job costs, allocated overhead, Job Profit, Job Margin, and variances.',
    href: '/calculators/job-profit',
  },
];
const guides = [
  {
    topic: 'Billable time',
    title: 'Billable vs Non-Billable Hours for Contractors',
    description: 'Learn what counts as billable time, how to measure billable utilization, and why realistic billable capacity matters.',
    href: '/guides/billable-vs-non-billable-hours-contractors/',
  },
  {
    topic: 'Labor pricing',
    title: 'How to Use Labor Burden in Construction Estimates and Job Pricing',
    description: 'Learn how to apply an already-calculated productive-hour labor cost in estimates, bids, change orders, and job-cost reviews.',
    href: '/guides/labor-burden-construction-estimates/',
  },
  {
    topic: 'Hiring costs',
    title: 'Cost to Hire an Employee for Small Contractors',
    description: 'Plan for recruiting, onboarding, setup, training, and ramp-up costs when bringing a new employee into the business.',
    href: '/guides/cost-to-hire-an-employee/',
  },
  {
    topic: 'Overhead',
    title: 'How to Allocate Overhead to Construction Jobs',
    description: 'Choose between labor hours, labor dollars, direct costs, and revenue, then apply the selected recovery rate to jobs.',
    href: '/guides/how-to-allocate-overhead-to-construction-jobs/',
  },
  {
    topic: 'Job costing',
    title: 'Estimated vs Actual Job Costs: How Contractors Find Profit Leaks',
    description: 'Diagnose job-cost variances, identify labor, material, revenue, and overhead causes, and correct the relevant inputs in future estimates.',
    href: '/guides/estimated-vs-actual-job-costs/',
  },
];
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <section class="hero home-hero" aria-labelledby="home-title">
    <div class="hero-content">
      <p class="eyebrow">Practical business planning</p>
      <h1 id="home-title"><span>Know What the Job Is</span> <span class="hero-title-accent">Worth Before You Bid.</span></h1>
      <p class="hero-copy">
        Contractor Money Tools helps U.S. contractors and home-service business owners understand labor cost,
        employee cost, hourly pricing, and profitability.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/calculators/">Explore Calculators</a>
        <a class="button button-secondary" href="/calculators/contractor-hourly-rate">Calculate Your Hourly Rate</a>
      </div>
    </div>
    <aside class="hero-sample blueprint-grid" aria-label="Illustrative contractor hourly rate example">
      <div class="work-order-meta">
        <span class="calculator-serial">CMT-03</span>
        <span class="calculator-category">Pricing · Illustrative example</span>
      </div>
      <p class="sample-question">What should I charge?</p>
      <p class="sample-formula">Labor + overhead + target margin</p>
      <p class="sample-result"><span>$87.40</span> <small>/ HR</small></p>
      <p class="sample-truth">Illustrative example — not a benchmark. Your result depends on your business inputs.</p>
    </aside>
  </section>

  <section class="page-section" aria-labelledby="live-calculators-title">
    <div class="section-intro">
      <p class="eyebrow">Live calculators</p>
      <h2 id="live-calculators-title">Start with the business question you need to answer</h2>
      <p>Each tool uses editable assumptions and explains how its result is calculated.</p>
    </div>
    <div class="card-grid">
      {calculators.map((calculator) => (
        <CalculatorCard {...calculator} />
      ))}
    </div>
  </section>

  <section class="page-section split-section" aria-labelledby="choose-title">
    <div>
      <p class="eyebrow">Choose the right tool</p>
      <h2 id="choose-title">Match the calculator to your decision</h2>
    </div>
    <ul class="decision-list decision-board">
      <li><span>True productive labor cost</span><a href="/calculators/labor-burden">Use Labor Burden</a></li>
      <li><span>Total annual employee cost</span><a href="/calculators/true-employee-cost">Use True Employee Cost</a></li>
      <li><span>What to charge customers</span><a href="/calculators/contractor-hourly-rate">Use Contractor Hourly Rate</a></li>
      <li><span>Job cost plus markup</span><a href="/calculators/contractor-markup">Use Contractor Markup</a></li>
      <li><span>Business overhead and recovery</span><a href="/calculators/contractor-overhead">Use Contractor Overhead</a></li>
      <li><span>Estimated versus actual job performance</span><a href="/calculators/job-profit">Use Job Profit &amp; Costing</a></li>
    </ul>
  </section>

  <section class="page-section guides-discovery" aria-labelledby="guides-title">
    <div class="section-intro guides-heading">
      <div>
        <p class="eyebrow">Field notes</p>
        <h2 id="guides-title">Practical guides for better inputs and decisions</h2>
      </div>
      <a class="section-link" href="/guides/">View all guides <span aria-hidden="true">→</span></a>
    </div>
    <div class="editorial-list">
      {guides.map((guide) => (
        <article class="editorial-card">
          <p class="guide-topic">{guide.topic}</p>
          <div>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </div>
          <a href={guide.href}>Read guide <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section trust-section" aria-labelledby="why-title">
    <p class="eyebrow">Why Contractor Money Tools</p>
    <h2 id="why-title">Useful numbers with the assumptions in view</h2>
    <ul class="feature-grid">
      <li><strong>Transparent formulas</strong><span>See how each result is built.</span></li>
      <li><strong>Editable assumptions</strong><span>Use values that fit your business.</span></li>
      <li><strong>No account required</strong><span>Open a calculator and start planning.</span></li>
      <li><strong>Practical planning</strong><span>Focus on real contractor business decisions.</span></li>
      <li><strong>Explained results</strong><span>Understand the output, not just the number.</span></li>
    </ul>
  </section>

  <section class="page-section audience-section" aria-labelledby="audience-title">
    <div>
      <p class="eyebrow">Built for service businesses</p>
      <h2 id="audience-title">For contractors who need clearer business numbers</h2>
    </div>
    <p>
      Designed for HVAC, plumbing, electrical, roofing, remodeling, landscaping, painting, cleaning,
      pest-control, and similar U.S. service businesses.
    </p>
  </section>

  <section class="final-cta" aria-labelledby="final-cta-title">
    <div>
      <p class="eyebrow">Ready to run the numbers?</p>
      <h2 id="final-cta-title">Choose a calculator and use your own assumptions.</h2>
    </div>
    <a class="button button-primary" href="/calculators/">Explore Calculators</a>
  </section>
</SiteLayout>
