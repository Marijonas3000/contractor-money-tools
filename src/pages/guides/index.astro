---
import SiteLayout from '../../layouts/SiteLayout.astro';

const pageTitle = 'Contractor Business Guides | Contractor Money Tools';
const pageDescription = 'Practical guides for contractors covering billable time, business capacity, costs, pricing, and profitability.';
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <header class="content-hero">
    <p class="eyebrow">Practical explanations</p>
    <h1>Contractor Business Guides</h1>
    <p>Clear explanations that support better use of Contractor Money Tools calculators.</p>
  </header>

  <section aria-labelledby="published-guides-title">
    <h2 id="published-guides-title" class="visually-hidden">Published guides</h2>
    <div class="card-grid guide-directory">
      <article class="tool-card">
        <h3>Billable vs Non-Billable Hours for Contractors</h3>
        <p>Learn what counts as billable time, how to measure billable utilization, and why realistic billable capacity matters.</p>
        <a class="card-link" href="/guides/billable-vs-non-billable-hours-contractors/">Read guide <span aria-hidden="true">→</span></a>
      </article>
      <article class="tool-card">
        <h3>How to Use Labor Burden in Construction Estimates and Job Pricing</h3>
        <p>Learn how to apply an already-calculated productive-hour labor cost in estimates, bids, change orders, and job-cost reviews.</p>
        <a class="card-link" href="/guides/labor-burden-construction-estimates/">Read guide <span aria-hidden="true">→</span></a>
      </article>
      <article class="tool-card">
        <h3>Cost to Hire an Employee for Small Contractors</h3>
        <p>Plan for recruiting, onboarding, setup, training, and ramp-up costs when bringing a new employee into the business.</p>
        <a class="card-link" href="/guides/cost-to-hire-an-employee/">Read guide <span aria-hidden="true">→</span></a>
      </article>
      <article class="tool-card">
        <h3>How to Allocate Overhead to Construction Jobs</h3>
        <p>Choose between labor hours, labor dollars, direct costs, and revenue, then apply the selected recovery rate to jobs.</p>
        <a class="card-link" href="/guides/how-to-allocate-overhead-to-construction-jobs/">Read guide <span aria-hidden="true">→</span></a>
      </article>
      <article class="tool-card">
        <h3>Estimated vs Actual Job Costs: How Contractors Find Profit Leaks</h3>
        <p>Diagnose job-cost variances, identify labor, material, revenue, and overhead causes, and correct the relevant inputs in future estimates.</p>
        <a class="card-link" href="/guides/estimated-vs-actual-job-costs/">Read guide <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>
</SiteLayout>
